PORT=3000
# Stringa lunga e casuale: cambiala prima di andare online.
# Puoi generarne una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-questo-con-una-stringa-lunga-e-casuale
# Cartella dove viene salvato il file dei dati (deve essere su un volume persistente in produzione)
DATA_DIR=./data
# Opzionale: username dell'account che riceve il foglio Finanze con i TUOI dati.
# Se lasci vuoto, e' il primo account creato su questo server.
OWNER_USERNAME=

# Dove salvare le copie di sicurezza automatiche (default: cartella DailyMate-backup nella tua cartella utente)
# BACKUP_DIR=C:\Users\TuoNome\DailyMate-backup
